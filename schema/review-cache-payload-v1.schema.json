{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gcomfident-crypto/stratadiff/main/schema/review-cache-payload-v1.schema.json",
  "title": "StrataDiff review cache selected payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_version",
    "canonicalization",
    "mode",
    "repository",
    "pull_request",
    "base_commit",
    "head_commit",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "https://raw.githubusercontent.com/gcomfident-crypto/stratadiff/main/schema/review-cache-payload-v1.schema.json"
    },
    "contract_version": { "const": "1.0.0" },
    "canonicalization": { "const": "stratadiff-canonical-json-v1" },
    "mode": { "enum": ["empty", "residue", "full", "blocked"] },
    "repository": { "$ref": "#/$defs/repository" },
    "pull_request": { "$ref": "#/$defs/pull_request" },
    "base_commit": { "$ref": "#/$defs/object_id" },
    "head_commit": { "$ref": "#/$defs/object_id" },
    "items": {
      "type": "array",
      "maxItems": 20000,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "base64_path": {
      "type": ["string", "null"],
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "maxLength": 5464
    },
    "mode": {
      "type": ["string", "null"],
      "pattern": "^[0-7]{6}$"
    },
    "nullable_object_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "host", "owner", "name", "repository_id", "object_format"],
      "properties": {
        "provider": { "const": "github" },
        "host": { "type": "string", "minLength": 1, "maxLength": 253 },
        "owner": { "type": "string", "minLength": 1, "maxLength": 100 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "repository_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "object_format": { "const": "sha1" }
      }
    },
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "number", "metadata_sha256"],
      "properties": {
        "node_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "number": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "metadata_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "similarity_percent",
        "before_path_base64",
        "after_path_base64",
        "before_mode",
        "after_mode",
        "before_object_id",
        "after_object_id"
      ],
      "properties": {
        "status": { "enum": ["added", "copied", "deleted", "modified", "renamed", "type_changed"] },
        "similarity_percent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "before_path_base64": { "$ref": "#/$defs/base64_path" },
        "after_path_base64": { "$ref": "#/$defs/base64_path" },
        "before_mode": { "$ref": "#/$defs/mode" },
        "after_mode": { "$ref": "#/$defs/mode" },
        "before_object_id": { "$ref": "#/$defs/nullable_object_id" },
        "after_object_id": { "$ref": "#/$defs/nullable_object_id" }
      }
    },
    "item": {
      "oneOf": [
        { "$ref": "#/$defs/change_item" },
        { "$ref": "#/$defs/base_drift_item" },
        { "$ref": "#/$defs/retained_non_current_item" }
      ]
    },
    "change_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_sha256",
        "kind",
        "identity_sha256",
        "identity",
        "before_source",
        "after_source"
      ],
      "properties": {
        "obligation_sha256": { "$ref": "#/$defs/sha256" },
        "kind": { "enum": ["current_change", "retired_checkpoint_change"] },
        "identity_sha256": { "$ref": "#/$defs/sha256" },
        "identity": { "$ref": "#/$defs/identity" },
        "before_source": { "$ref": "#/$defs/source" },
        "after_source": { "$ref": "#/$defs/source" }
      }
    },
    "source": {
      "oneOf": [
        { "$ref": "#/$defs/source_absent" },
        { "$ref": "#/$defs/source_blob" },
        { "$ref": "#/$defs/source_gitlink" }
      ]
    },
    "source_absent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "absent" }
      }
    },
    "source_blob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "object_id", "byte_length", "sha256", "content_base64"],
      "properties": {
        "kind": { "const": "git_blob" },
        "object_id": { "$ref": "#/$defs/object_id" },
        "byte_length": { "type": "integer", "minimum": 0, "maximum": 67108864 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "content_base64": { "type": "string", "maxLength": 89478488 }
      }
    },
    "source_gitlink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "object_id"],
      "properties": {
        "kind": { "const": "gitlink" },
        "object_id": { "$ref": "#/$defs/object_id" }
      }
    },
    "base_drift_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "old_base_commit",
        "old_base_tree",
        "current_base_commit",
        "current_base_tree",
        "changes"
      ],
      "properties": {
        "kind": { "const": "base_drift_v1" },
        "old_base_commit": { "$ref": "#/$defs/object_id" },
        "old_base_tree": { "$ref": "#/$defs/object_id" },
        "current_base_commit": { "$ref": "#/$defs/object_id" },
        "current_base_tree": { "$ref": "#/$defs/object_id" },
        "changes": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/base_drift_change" }
        }
      }
    },
    "base_drift_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_sha256", "identity", "before_source", "after_source"],
      "properties": {
        "identity_sha256": { "$ref": "#/$defs/sha256" },
        "identity": { "$ref": "#/$defs/identity" },
        "before_source": { "$ref": "#/$defs/source" },
        "after_source": { "$ref": "#/$defs/source" }
      }
    },
    "base_drift_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_sha256", "kind", "evidence_sha256", "evidence"],
      "properties": {
        "obligation_sha256": { "$ref": "#/$defs/sha256" },
        "kind": { "const": "base_drift" },
        "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "evidence": { "$ref": "#/$defs/base_drift_evidence" }
      }
    },
    "retired_change_item": {
      "allOf": [
        { "$ref": "#/$defs/change_item" },
        {
          "properties": {
            "kind": { "const": "retired_checkpoint_change" }
          }
        }
      ]
    },
    "retained_non_current_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_sha256",
        "kind",
        "origin_receipt_body_sha256",
        "original_item"
      ],
      "properties": {
        "obligation_sha256": { "$ref": "#/$defs/sha256" },
        "kind": { "const": "retained_non_current_obligation" },
        "origin_receipt_body_sha256": { "$ref": "#/$defs/sha256" },
        "original_item": {
          "oneOf": [
            { "$ref": "#/$defs/retired_change_item" },
            { "$ref": "#/$defs/base_drift_item" }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "empty" } } },
      "then": { "properties": { "items": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "mode": { "const": "blocked" } } },
      "then": { "properties": { "items": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "mode": { "const": "residue" } } },
      "then": { "properties": { "items": { "minItems": 1 } } }
    }
  ]
}

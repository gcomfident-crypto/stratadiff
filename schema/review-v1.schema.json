{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gcomfident-crypto/stratadiff/main/schema/review-v1.schema.json",
  "title": "StrataDiff repository review v1",
  "description": "A deterministic, producer-attested review-focus summary with optional exact checkpoint carry-forward. It does not contain the per-file reports needed for offline replay verification, assert semantic equivalence, prove that a checkpoint was reviewed, or approve a change.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "engine_version",
    "requested_base",
    "requested_head",
    "base_commit",
    "head_commit",
    "comparison",
    "summary",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "https://raw.githubusercontent.com/gcomfident-crypto/stratadiff/main/schema/review-v1.schema.json"
    },
    "engine_version": { "type": "string", "minLength": 1 },
    "requested_base": { "type": "string", "minLength": 1 },
    "requested_head": { "type": "string", "minLength": 1 },
    "base_commit": { "$ref": "#/$defs/object_id" },
    "head_commit": { "$ref": "#/$defs/object_id" },
    "comparison": { "const": "merge_base_to_head" },
    "checkpoint": { "$ref": "#/$defs/review_checkpoint" },
    "summary": { "$ref": "#/$defs/summary" },
    "files": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "allOf": [
    {
      "if": { "required": ["checkpoint"] },
      "then": {
        "properties": {
          "summary": { "required": ["checkpoint"] },
          "files": { "items": { "required": ["checkpoint_state"] } }
        }
      },
      "else": {
        "properties": {
          "summary": { "not": { "required": ["checkpoint"] } },
          "files": {
            "items": {
              "not": {
                "anyOf": [
                  { "required": ["checkpoint_state"] },
                  { "required": ["checkpoint_match_basis"] }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "object_id": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "git_mode": {
      "type": "string",
      "pattern": "^[0-7]{6}$"
    },
    "checkpoint_state": {
      "enum": ["needs_review_now", "unchanged_since_checkpoint"],
      "description": "Whether the current change was carried from the caller-selected checkpoint by the declared match basis."
    },
    "checkpoint_match_basis": {
      "enum": ["exact_git_change_identity", "exact_noninteracting_four_way_byte_replay"],
      "description": "The exact factual basis for carrying this current change from the checkpoint."
    },
    "review_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_revision", "commit", "base_commit", "match_basis"],
      "properties": {
        "requested_revision": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/object_id" },
        "base_commit": { "$ref": "#/$defs/object_id" },
        "match_basis": {
          "enum": [
            "exact_git_change_identity",
            "exact_git_change_identity_or_noninteracting_four_way_byte_replay"
          ],
          "description": "The fail-closed carry policy. Four-way replay is available only when the checkpoint and current merge bases differ."
        }
      }
    },
    "checkpoint_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "needs_review_now_files",
        "unchanged_since_checkpoint_files",
        "retired_change_count"
      ],
      "properties": {
        "needs_review_now_files": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "unchanged_since_checkpoint_files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "retired_change_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "Checkpoint change identities that do not appear unchanged in the current range, including identities superseded by a current mutation."
        }
      }
    },
    "language": {
      "enum": [
        "universal",
        "python",
        "javascript",
        "typescript",
        "tsx",
        "rust",
        "java",
        "json",
        "c",
        "cpp",
        "c_sharp",
        "go",
        "ruby",
        "bash",
        "php",
        "html",
        "css",
        "yaml",
        "toml",
        "markdown",
        "kotlin",
        "swift",
        "lua",
        "scala",
        "r",
        "elixir",
        "haskell",
        "ocaml",
        "ocaml_interface",
        "zig"
      ]
    },
    "line_change_envelope": {
      "type": "object",
      "description": "A conservative common-prefix/suffix line envelope. It may exceed a minimal Git diffstat and is deliberately computed in linear time.",
      "additionalProperties": false,
      "required": ["additions", "deletions"],
      "properties": {
        "additions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 }
      }
    },
    "change_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "insertions",
        "deletions",
        "equivalent_relocations",
        "child_order_changes",
        "model_forced_updates",
        "suggested_updates",
        "formatting_only"
      ],
      "properties": {
        "insertions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 },
        "equivalent_relocations": { "type": "integer", "minimum": 0 },
        "child_order_changes": { "type": "integer", "minimum": 0 },
        "model_forced_updates": { "type": "integer", "minimum": 0 },
        "suggested_updates": { "type": "integer", "minimum": 0 },
        "formatting_only": { "type": "integer", "minimum": 0 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_blake3",
        "replay_check_passed_during_analysis",
        "model_forced_relations",
        "suggested_relations",
        "ambiguity_groups",
        "byte_edits",
        "changes"
      ],
      "properties": {
        "report_blake3": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Digest of the single-file report checked while producing this summary. The report itself is not embedded in review-v1."
        },
        "replay_check_passed_during_analysis": {
          "const": true,
          "description": "Producer-attested result of replaying the single-file patch during analysis; not independently derivable from review-v1 alone."
        },
        "model_forced_relations": { "type": "integer", "minimum": 0 },
        "suggested_relations": { "type": "integer", "minimum": 0 },
        "ambiguity_groups": { "type": "integer", "minimum": 0 },
        "byte_edits": { "type": "integer", "minimum": 0 },
        "changes": { "$ref": "#/$defs/change_counts" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "priority", "lane", "reason"],
      "properties": {
        "status": {
          "enum": ["added", "copied", "deleted", "modified", "renamed", "type_changed"]
        },
        "similarity_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "before_path": { "type": "string", "minLength": 1 },
        "before_path_encoding": { "$ref": "#/$defs/path_encoding" },
        "after_path": { "type": "string", "minLength": 1 },
        "after_path_encoding": { "$ref": "#/$defs/path_encoding" },
        "before_mode": { "$ref": "#/$defs/git_mode" },
        "after_mode": { "$ref": "#/$defs/git_mode" },
        "before_blob": { "$ref": "#/$defs/object_id" },
        "after_blob": { "$ref": "#/$defs/object_id" },
        "before_bytes": { "type": "integer", "minimum": 0 },
        "after_bytes": { "type": "integer", "minimum": 0 },
        "line_change_envelope": { "$ref": "#/$defs/line_change_envelope" },
        "language": { "$ref": "#/$defs/language" },
        "priority": {
          "enum": ["review_first", "evidence_follow_up"],
          "description": "Attention order, kept separate from the factual evidence class. The conservative alpha policy emits review_first for every file."
        },
        "lane": {
          "enum": ["review_first", "syntax_preserved", "content_preserved", "unverified"],
          "description": "Factual evidence class. Historical enum names do not imply semantic equivalence or permission to lower review priority."
        },
        "checkpoint_state": { "$ref": "#/$defs/checkpoint_state" },
        "checkpoint_match_basis": { "$ref": "#/$defs/checkpoint_match_basis" },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "checkpoint_state": { "const": "unchanged_since_checkpoint" } },
            "required": ["checkpoint_state"]
          },
          "then": { "required": ["checkpoint_match_basis"] }
        },
        {
          "if": {
            "properties": { "checkpoint_state": { "const": "needs_review_now" } },
            "required": ["checkpoint_state"]
          },
          "then": { "not": { "required": ["checkpoint_match_basis"] } }
        }
      ],
      "dependentRequired": {
        "before_path": ["before_path_encoding"],
        "after_path": ["after_path_encoding"]
      }
    },
    "path_encoding": {
      "enum": ["utf8", "git_bytes_percent_encoded"]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed_files",
        "first_pass_files",
        "review_first_files",
        "syntax_preserved_files",
        "content_preserved_files",
        "unverified_files",
        "replay_check_passed_files",
        "replay_check_not_run_files",
        "line_envelope_complete"
      ],
      "properties": {
        "changed_files": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "first_pass_files": {
          "type": "integer",
          "minimum": 0,
          "description": "Files whose attention priority is review_first, regardless of evidence class."
        },
        "review_first_files": {
          "type": "integer",
          "minimum": 0,
          "description": "Files in the historical review_first evidence class (displayed as structural delta), not the total first-pass priority count."
        },
        "syntax_preserved_files": {
          "type": "integer",
          "minimum": 0,
          "description": "Files whose parser-model predicate matched; this is non-semantic evidence."
        },
        "content_preserved_files": {
          "type": "integer",
          "minimum": 0,
          "description": "Files whose paired Git object IDs match; metadata effects remain first-pass."
        },
        "unverified_files": { "type": "integer", "minimum": 0 },
        "replay_check_passed_files": {
          "type": "integer",
          "minimum": 0,
          "description": "Files whose paired single-file reports passed replay during production; other files may be inapplicable or not analyzed."
        },
        "replay_check_not_run_files": {
          "type": "integer",
          "minimum": 0,
          "description": "Files for which a paired single-file replay check was not run or was not applicable."
        },
        "line_envelope_complete": { "type": "boolean" },
        "changed_line_envelope": { "type": "integer", "minimum": 0 },
        "first_pass_line_envelope": { "type": "integer", "minimum": 0 },
        "checkpoint": { "$ref": "#/$defs/checkpoint_summary" }
      }
    }
  }
}

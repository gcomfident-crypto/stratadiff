#!/usr/bin/env bash

set -euo pipefail

if [[ "${1:-}" == review ]]; then
  printf 'stratadiff' > "${HOME}/review-call.txt"
  printf ' %s' "$@" >> "${HOME}/review-call.txt"
  printf '\n' >> "${HOME}/review-call.txt"
  env | LC_ALL=C sort > "${HOME}/review-environment.txt"
  exit 0
fi

if [[ "${1:-}" == demo ]]; then
  printf 'stratadiff' > "${HOME}/demo-call.txt"
  printf ' %s' "$@" >> "${HOME}/demo-call.txt"
  printf '\n' >> "${HOME}/demo-call.txt"
  env | LC_ALL=C sort > "${HOME}/demo-environment.txt"
  if [[ -f "${HOME}/demo-wait" ]]; then
    trap 'printf "HUP\n" > "${HOME}/demo-signal.txt"; exit 0' HUP
    trap 'printf "INT\n" > "${HOME}/demo-signal.txt"; exit 0' INT
    trap 'printf "TERM\n" > "${HOME}/demo-signal.txt"; exit 0' TERM
    : > "${HOME}/demo-ready"
    while true; do
      sleep 1
    done
  fi
  exit 0
fi

printf 'stratadiff' >> "${STRATADIFF_EXTENSION_TEST_LOG}"
printf ' %s' "$@" >> "${STRATADIFF_EXTENSION_TEST_LOG}"
printf '\n' >> "${STRATADIFF_EXTENSION_TEST_LOG}"

checkpoint=cccccccccccccccccccccccccccccccccccccccc
base=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
case "${1:-}" in
  github-checkpoint)
    reviews_path=$2
    reviews_payload="$(< "${reviews_path}")"
    [[ " $* " == *" --gh-slurp-pages "* ]]
    [[ " $* " != *" --gh-included-response "* ]]
    [[ "${reviews_payload}" == \[\[* ]]
    [[ "${reviews_payload: -2}" == "]]" ]]
    if [[ "${GH_STUB_MULTI_PAGE_REVIEWS:-false}" == true ]]; then
      [[ "${reviews_payload}" == *'}],[{'* ]]
      [[ "${reviews_payload}" == *'"id":100'* ]]
      [[ "${reviews_payload}" == *'"id":101'* ]]
    else
      [[ "${reviews_payload}" == *'"id":101'* ]]
      [[ "${reviews_payload}" == *'"id":102'* ]]
    fi
    if [[ "${GH_STUB_NO_REVIEW:-false}" != true ]]; then
      printf '%s\n' "${checkpoint}"
    fi
    exit 0
    ;;
  github-commit-object)
    while [[ $# -gt 0 ]]; do
      if [[ "$1" == --expected ]]; then
        printf '%s\n' "$2"
        exit 0
      fi
      shift
    done
    exit 70
    ;;
  github-ownership-snapshot)
    [[ "${2:-}" == "${base}" ]]
    repository=
    github_repository=
    provider_url=
    output=
    shift 2
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --repo)
          repository=$2
          shift 2
          ;;
        --github-repository)
          github_repository=$2
          shift 2
          ;;
        --provider-url)
          provider_url=$2
          shift 2
          ;;
        --output)
          output=$2
          shift 2
          ;;
        *) exit 70 ;;
      esac
    done
    [[ "${repository}" == "${GH_STUB_REPOSITORY_DIRECTORY}" ]]
    [[ "${github_repository}" == acme/widget ]]
    if [[ "${GH_STUB_ENTERPRISE:-false}" == true ]]; then
      [[ "${provider_url}" == https://ghe.example ]]
    else
      [[ "${provider_url}" == https://github.com ]]
    fi
    [[ -n "${output}" ]]
    if [[ "${GH_STUB_OWNERSHIP_FAIL:-false}" == true ]]; then
      exit 1
    fi
    printf '{"base_commit":"%s"}\n' "${base}" > "${output}"
    ;;
  *)
    printf 'unexpected stratadiff invocation: %s\n' "$*" >&2
    exit 70
    ;;
esac

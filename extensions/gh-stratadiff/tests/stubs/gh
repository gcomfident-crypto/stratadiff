#!/usr/bin/env bash

set -euo pipefail

printf 'gh' >> "${STRATADIFF_EXTENSION_TEST_LOG}"
printf ' %s' "$@" >> "${STRATADIFF_EXTENSION_TEST_LOG}"
printf '\n' >> "${STRATADIFF_EXTENSION_TEST_LOG}"

base=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
head=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
checkpoint=cccccccccccccccccccccccccccccccccccccccc

print_multi_page_reviews() {
  local id
  local separator=
  printf '[['
  for ((id = 1; id <= 100; id++)); do
    printf '%s' "${separator}"
    separator=,
    if [[ "${id}" -eq 1 ]]; then
      printf '{"id":1,"user":{"login":"alice","type":"User"},"state":"APPROVED","html_url":"https://github.com/acme/widget/pull/17#pullrequestreview-1","commit_id":"%s","submitted_at":"2026-09-04T17:10:09Z","author_association":"MEMBER"}' "${base}"
    else
      printf '{"id":%s,"user":{"login":"other","type":"User"},"state":"COMMENTED","html_url":"https://github.com/acme/widget/pull/17#pullrequestreview-%s","commit_id":"%s","submitted_at":"2026-09-04T18:10:09Z","author_association":"MEMBER"}' "${id}" "${id}" "${base}"
    fi
  done
  printf '],[{"id":101,"user":{"login":"alice","type":"User"},"state":"CHANGES_REQUESTED","html_url":"https://github.com/acme/widget/pull/17#pullrequestreview-101","commit_id":"%s","submitted_at":"2026-09-04T19:10:09Z","author_association":"MEMBER"}]]\n' "${checkpoint}"
}

case "${1:-} ${2:-}" in
  "repo view")
    if [[ "${GH_STUB_COMMAND:-}" == audit || "${GH_STUB_COMMAND:-}" == inbox ]]; then
      [[ "${PWD}" == "${GH_STUB_AUDIT_CWD}" ]]
      if [[ "${GH_TEST_AUDIT_INFER:-false}" == true || "${GH_TEST_INBOX_INFER:-false}" == true ]]; then
        [[ " $* " != *" github.com/acme/widget "* ]]
        [[ " $* " != *" ghe.example/acme/widget "* ]]
      elif [[ "${GH_STUB_ENTERPRISE:-false}" == true ]]; then
        [[ " $* " == *" ghe.example/acme/widget "* ]]
      else
        [[ " $* " == *" github.com/acme/widget "* ]]
      fi
    else
      [[ "${PWD}" == "${GH_STUB_REPOSITORY_DIRECTORY}" ]]
    fi
    if [[ "${GH_STUB_ENTERPRISE:-false}" == true ]]; then
      [[ " $* " == *" ghe.example/acme/widget "* ]]
      printf 'acme/widget\thttps://ghe.example/acme/widget\n'
    else
      printf 'acme/widget\thttps://github.com/acme/widget\n'
    fi
    ;;
  "pr view")
    [[ " $* " == *" --repo github.com/acme/widget "* ]]
    count=0
    if [[ -f "${GH_STUB_STATE}/pr-count" ]]; then
      read -r count < "${GH_STUB_STATE}/pr-count"
    fi
    count=$((count + 1))
    printf '%s\n' "${count}" > "${GH_STUB_STATE}/pr-count"
    if [[ "${GH_STUB_HEAD_MOVES:-false}" == true && "${count}" -gt 1 ]]; then
      printf '17\t%s\t%s\n' "${base}" dddddddddddddddddddddddddddddddddddddddd
    else
      printf '17\t%s\t%s\n' "${base}" "${head}"
    fi
    ;;
  "auth token")
    printf 'stub-github-token\n'
    ;;
  "api --hostname"|"api --paginate"|"api --include")
    arguments=" $* "
    if [[ "${arguments}" == *" user "* ]]; then
      printf 'alice\n'
    elif [[ "${arguments}" == *"/pulls/17/reviews?per_page=100 "* ]]; then
      [[ "${arguments}" == *" --paginate "* ]]
      [[ "${arguments}" == *" --slurp "* ]]
      [[ "${arguments}" != *" --include "* ]]
      if [[ "${GH_STUB_REVIEWS_API_FAIL:-false}" == true ]]; then
        exit 1
      fi
      if [[ "${GH_STUB_MULTI_PAGE_REVIEWS:-false}" == true ]]; then
        print_multi_page_reviews
      else
        printf '%s\n' '[[{"id":101,"user":{"login":"alice","type":"User"},"state":"APPROVED","html_url":"https://github.com/acme/widget/pull/17#pullrequestreview-101","commit_id":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","submitted_at":"2026-09-04T17:10:09Z","author_association":"MEMBER"},{"id":102,"user":{"login":"alice","type":"User"},"state":"APPROVED","html_url":"https://github.com/acme/widget/pull/17#pullrequestreview-102","commit_id":"cccccccccccccccccccccccccccccccccccccccc","submitted_at":"2026-09-04T19:10:09Z","author_association":"MEMBER"}]]'
      fi
    elif [[ "${arguments}" == *"/git/commits/"* ]]; then
      object_id=${arguments##*/git/commits/}
      object_id=${object_id%% *}
      if [[ "${GH_STUB_PROVIDER_MISSING:-false}" == true && "${object_id}" == "${checkpoint}" ]] || \
        [[ "${GH_STUB_PROVIDER_MISSING_BASE:-false}" == true && "${object_id}" == "${base}" ]]
      then
        exit 1
      fi
      printf '{"sha":"%s"}\n' "${object_id}"
    else
      printf 'unexpected gh api invocation: %s\n' "$*" >&2
      exit 70
    fi
    ;;
  *)
    printf 'unexpected gh invocation: %s\n' "$*" >&2
    exit 70
    ;;
esac

  "oracle_contract": {
    "implementation_independent": true,
    "fixture_form": "Symbolic provider events, ownership snapshots, and Git snapshots. A future runner must materialize raw request bytes and Git objects without consulting product output to derive expected values.",
    "delivery_identity": "The original and every redelivery share one delivery_id. The first valid observation is canonical. A later observation with the same event name and raw-body digest is duplicate even when its local received_at differs; the first received_at is retained. The same delivery_id with a different event name or raw-body digest is an atomic conflict.",
    "authentication": "Verify HMAC-SHA256 over the exact raw body before JSON decoding or state mutation. X-GitHub-Delivery is not covered by the body HMAC, so authenticity and deduplication are separate checks.",
    "review_reduction": "Receipts and dismissals are append-only facts. A dismissal targets its exact review_id and dominates that review regardless of delivery order, including when its nullable commit metadata is unavailable. A retained or delayed receipt supplies the immutable commit evidence; the tombstone must not invent it. For one reviewer, a dismissed latest completed review does not fall back to an older receipt; a distinct later completed review can reactivate coverage. Ambiguous ordering fails closed.",
    "head_reduction": "Synchronize payloads are transition evidence, not authoritative mutable state. Retain every valid transition, then reconcile effective head and base against an authoritative exact pull-request observation. A delayed older transition cannot roll state back; disconnected or unverifiable histories remain blocked.",
    "ownership_reduction": "Load CODEOWNERS only from the exact protected-base commit, using .github/CODEOWNERS, CODEOWNERS, then docs/CODEOWNERS precedence. The last matching rule wins. Owners on that one rule form OR alternatives; distinct matched owner domains form independent requirements whose conjunction gates the pull request.",
    "ownership_snapshot_provenance": "Every identity reduction is bound to provider_url, repository_id, exact base_commit, GitHub API version, observed_at, stable user and team IDs, team privacy and repository permission, and active or pending membership state. A supplied snapshot without this provenance is not a reproducible oracle input.",
    "invalid_codeowners_policy": "Although GitHub can skip invalid CODEOWNERS lines, this benchmark deliberately applies Issue #14's stricter fail-closed policy: any invalid line in the selected source blocks all coverage evaluation and no lower-precedence source is substituted.",
    "carry_reduction": "Carry requires complete raw Git change-identity equality or the approved same-path regular-file four-snapshot byte witness. Four-way edits must be non-overlapping and non-adjacent, and both replay orders must reproduce the exact current bytes. All other current changes remain residue for every required owner domain.",
    "missing_object_policy": "Every receipt and carry proof is bound to exact full object IDs. An unavailable object is a blocker; no branch tip, current head, pull-request ref, mirror result, or alternate commit may substitute for it.",
    "gate": "The required check is green only when every required owner domain has proven coverage and no blocker exists. These oracles make no semantic-safety, approval-restoration, or safe-to-merge claim."
  },
  "snapshot_model": {
    "A": "reviewed checkpoint base",
    "B": "reviewed checkpoint commit, based on A",
    "C": "current protected-base commit",
    "D": "current pull-request head, based on C"
  },

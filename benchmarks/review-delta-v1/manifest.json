{
  "schema": "stratadiff-review-delta-benchmark-manifest-v1",
  "dataset_version": "1.0.0",
  "name": "Review Delta v1 controlled histories",
  "description": "Deterministic four-snapshot Git histories for the rebase-aware review-delta and Full PR scope contracts.",
  "dataset_license": "MIT",
  "file_scope": "Regular Git blobs with modes 100644 and 100755; symlinks and gitlinks are outside v1.",
  "snapshot_model": {
    "A": "old merge base",
    "B": "reviewed checkpoint, whose parent is A",
    "C": "current merge base, whose parent is A",
    "D": "current head, whose parent is C",
    "reconstructed_baseline": "S is the byte-identical result of replaying A->B and A->C in both orders"
  },
  "full_scope_contract": "Within the declared regular-blob scope, every Full PR entry and its Git identity must equal the independent C->D raw Git delta, even when the Resume scope uses S->D or B->D.",
  "required_coverage": [
    "pure_rebase",
    "absorbed_retired_change",
    "noninteracting_author_followup",
    "new_current_change",
    "drop_or_revert",
    "overlap_fallback",
    "adjacent_fallback",
    "binary_fallback",
    "add_fallback",
    "delete_fallback",
    "rename_fallback",
    "dropped_rename",
    "mode_fallback",
    "full_scope_c_to_d"
  ],
  "cases": [
    {
      "id": "pure-rebase-carries-reviewed-edit",
      "description": "An upstream edit and a reviewed edit commute; D equals reconstructed S, so Resume is empty while Full still shows C->D.",
      "covers": ["pure_rebase", "full_scope_c_to_d"],
      "history": {
        "A": {
          "files": {
            "shared.py": {"mode": "100644", "content": {"encoding": "utf8", "value": "title = 'old'\nreviewed = 0\n"}}
          }
        },
        "B": {
          "files": {
            "shared.py": {"mode": "100644", "content": {"encoding": "utf8", "value": "title = 'old'\nreviewed = 1\n"}}
          }
        },
        "C": {
          "files": {
            "shared.py": {"mode": "100644", "content": {"encoding": "utf8", "value": "title = 'new'\nreviewed = 0\n"}}
          }
        },
        "D": {
          "files": {
            "shared.py": {"mode": "100644", "content": {"encoding": "utf8", "value": "title = 'new'\nreviewed = 1\n"}}
          }
        }
      },
      "expected": {
        "review_summary": {"changed_files": 1, "needs_review_now_files": 0, "unchanged_since_checkpoint_files": 1, "retired_change_count": 0},
        "full_scope": [
          {"status": "modified", "before_path": "shared.py", "after_path": "shared.py", "additions": 1, "deletions": 1}
        ],
        "delta": {
          "comparison": "per_file_review_baseline_to_head",
          "summary": {"displayable_files": 0, "unresolved_retired_changes": 0, "needs_review_files": 0, "gate_passed": true},
          "entries": []
        }
      }
    },
    {
      "id": "noninteracting-author-followup",
      "description": "The reviewed and upstream edits commute, but the author adds one later edit; Resume must expose only that one-line S->D residue.",
      "covers": ["noninteracting_author_followup", "full_scope_c_to_d"],
      "history": {
        "A": {
          "files": {
            "shared.py": {"mode": "100644", "content": {"encoding": "utf8", "value": "title = 'old'\nreviewed = 0\nfollowup = 0\n"}}
          }
        },
        "B": {
          "files": {
            "shared.py": {"mode": "100644", "content": {"encoding": "utf8", "value": "title = 'old'\nreviewed = 1\nfollowup = 0\n"}}
          }
        },
        "C": {
          "files": {
            "shared.py": {"mode": "100644", "content": {"encoding": "utf8", "value": "title = 'new'\nreviewed = 0\nfollowup = 0\n"}}
          }
        },
        "D": {
          "files": {
            "shared.py": {"mode": "100644", "content": {"encoding": "utf8", "value": "title = 'new'\nreviewed = 1\nfollowup = 1\n"}}
          }
        }
      },
      "expected": {
        "review_summary": {"changed_files": 1, "needs_review_now_files": 1, "unchanged_since_checkpoint_files": 0, "retired_change_count": 1},
        "full_scope": [
          {"status": "modified", "before_path": "shared.py", "after_path": "shared.py", "additions": 2, "deletions": 2}
        ],
        "delta": {
          "comparison": "per_file_review_baseline_to_head",
          "summary": {"displayable_files": 1, "unresolved_retired_changes": 0, "needs_review_files": 1, "gate_passed": false},
          "entries": [
            {"status": "modified", "before_path": "shared.py", "after_path": "shared.py", "baseline_basis": "reconstructed_review_baseline", "fallback_reason": null, "before_source_kind": "reconstructed_bytes", "after_source_kind": "git_object", "additions": 1, "deletions": 1, "reconstructed_baseline_utf8": "title = 'new'\nreviewed = 1\nfollowup = 0\n"}
          ]
        }
      }
    },
    {
      "id": "upstream-absorbed-reviewed-addition",
      "description": "The current base already contains a byte-identical reviewed addition; the retired checkpoint identity is proven absorbed, so an empty Full and Resume scope must pass the gate.",
      "covers": ["absorbed_retired_change", "full_scope_c_to_d"],
      "history": {
        "A": {"files": {"seed.txt": {"mode": "100644", "content": {"encoding": "utf8", "value": "seed=0\n"}}}},
        "B": {"files": {"seed.txt": {"mode": "100644", "content": {"encoding": "utf8", "value": "seed=0\n"}}, "absorbed.py": {"mode": "100644", "content": {"encoding": "utf8", "value": "reviewed = 1\n"}}}},
        "C": {"files": {"seed.txt": {"mode": "100644", "content": {"encoding": "utf8", "value": "seed=1\n"}}, "absorbed.py": {"mode": "100644", "content": {"encoding": "utf8", "value": "reviewed = 1\n"}}}},
        "D": {"files": {"seed.txt": {"mode": "100644", "content": {"encoding": "utf8", "value": "seed=1\n"}}, "absorbed.py": {"mode": "100644", "content": {"encoding": "utf8", "value": "reviewed = 1\n"}}}}
      },
      "expected": {
        "review_summary": {"changed_files": 0, "needs_review_now_files": 0, "unchanged_since_checkpoint_files": 0, "retired_change_count": 1},
        "full_scope": [],
        "delta": {
          "comparison": "per_file_review_baseline_to_head",
          "summary": {"displayable_files": 0, "unresolved_retired_changes": 0, "needs_review_files": 0, "gate_passed": true},
          "entries": []
        }
      }
    },
    {
      "id": "new-current-file-after-checkpoint",
      "description": "One reviewed file is carried exactly while a new unrelated file appears after the checkpoint; Resume must contain only the new C->D addition.",
      "covers": ["new_current_change", "full_scope_c_to_d"],
      "history": {
        "A": {"files": {"seed.txt": {"mode": "100644", "content": {"encoding": "utf8", "value": "seed=0\n"}}, "reviewed.py": {"mode": "100644", "content": {"encoding": "utf8", "value": "reviewed = 0\n"}}}},
        "B": {"files": {"seed.txt": {"mode": "100644", "content": {"encoding": "utf8", "value": "seed=0\n"}}, "reviewed.py": {"mode": "100644", "content": {"encoding": "utf8", "value": "reviewed = 1\n"}}}},
        "C": {"files": {"seed.txt": {"mode": "100644", "content": {"encoding": "utf8", "value": "seed=1\n"}}, "reviewed.py": {"mode": "100644", "content": {"encoding": "utf8", "value": "reviewed = 0\n"}}}},
        "D": {"files": {"seed.txt": {"mode": "100644", "content": {"encoding": "utf8", "value": "seed=1\n"}}, "reviewed.py": {"mode": "100644", "content": {"encoding": "utf8", "value": "reviewed = 1\n"}}, "new.py": {"mode": "100644", "content": {"encoding": "utf8", "value": "new = 1\n"}}}}
      },
      "expected": {
        "review_summary": {"changed_files": 2, "needs_review_now_files": 1, "unchanged_since_checkpoint_files": 1, "retired_change_count": 0},
        "full_scope": [
          {"status": "added", "before_path": null, "after_path": "new.py", "additions": 1, "deletions": 0},
          {"status": "modified", "before_path": "reviewed.py", "after_path": "reviewed.py", "additions": 1, "deletions": 1}
        ],
        "delta": {
          "comparison": "per_file_review_baseline_to_head",
          "summary": {"displayable_files": 1, "unresolved_retired_changes": 0, "needs_review_files": 1, "gate_passed": false},
          "entries": [
            {"status": "added", "before_path": null, "after_path": "new.py", "baseline_basis": "current_base_no_checkpoint_change", "fallback_reason": null, "before_source_kind": "empty", "after_source_kind": "git_object", "additions": 1, "deletions": 0, "reconstructed_baseline_utf8": null}
          ]
        }
      }
    },
    {
      "id": "dropped-reviewed-edit",
      "description": "The reviewed edit disappears and C->D is empty; Resume must still show the reconstructed deletion and keep the gate open.",
      "covers": ["drop_or_revert", "full_scope_c_to_d"],

      "expected": {
        "review_summary": {"changed_files": 0, "needs_review_now_files": 0, "unchanged_since_checkpoint_files": 0, "retired_change_count": 1},
        "full_scope": [],
        "delta": {
          "comparison": "per_file_review_baseline_to_head",
          "summary": {"displayable_files": 1, "unresolved_retired_changes": 0, "needs_review_files": 1, "gate_passed": false},
          "entries": [
            {"status": "modified", "before_path": "shared.py", "after_path": "shared.py", "baseline_basis": "reconstructed_review_baseline", "fallback_reason": null, "before_source_kind": "reconstructed_bytes", "after_source_kind": "git_object", "additions": 1, "deletions": 1, "reconstructed_baseline_utf8": "title = 'new'\nreviewed = 1\n"}
          ]
        }
      }
    },
    {

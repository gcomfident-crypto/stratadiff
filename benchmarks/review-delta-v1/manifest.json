        "C": {"files": {"shared.py": {"mode": "100644", "content": {"encoding": "utf8", "value": "value = 2222\n"}}}},
        "D": {"files": {"shared.py": {"mode": "100644", "content": {"encoding": "utf8", "value": "value = 1111\n"}}}}

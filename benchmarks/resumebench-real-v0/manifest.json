  "description": "A pinned diagnostic sample of public Gerrit patch-set transitions with an explicit reviewed checkpoint and a later submitted revision.",
  "dataset_license": "MIT",
  "selection_protocol": {
    "kind": "diagnostic_stratified_sample",
    "provider": "Gerrit",
    "instance": "https://gerrit-review.googlesource.com",
    "project": "gerrit",
    "inclusion_rule": "Public merged changes with a Code-Review+2 event bound to an earlier patch set and at least one later patch set whose Git objects remain fetchable.",
    "strata": [
      "mixed_carried_changed_and_new",
      "one_changed_among_many",
      "submitted_with_one_unreviewed_file",
      "no_code_change",
      "base_drift_fail_closed"
    ],
    "prevalence_claim": false
  },
  "source_repository": {
    "id": "gerrit",
    "git_url": "https://gerrit.googlesource.com/gerrit",
    "default_branch": "master",
    "object_format": "sha1",
    "license": {
      "spdx_expression": "Apache-2.0",
      "path": "COPYING",
      "blob_oid": "d645695673349e3947e8e5ae42332d0ac3164cd7",
      "content_sha256": "cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30"
    }
  },
  "oracle_contract": {
    "schema": "stratadiff-resumebench-real-oracle-v0",
    "generator": "tools/resumebench-real/resumebench_real.py",
    "generator_sha256": "e553563d4c64af8b2a0a3a8cd2451a06587d14d29d8e70c6203cb465558e089d",
    "raw_git_command": "git diff-tree -r --raw -z --no-commit-id --no-abbrev --no-renames <left> <right> --",
    "identity_fields": [
      "status",
      "similarity_percent",
      "before_path_base64",
      "after_path_base64",
      "before_mode",
      "after_mode",
      "before_object_id",
      "after_object_id"
    ],
    "exact_relocation_rule": "Pair a deletion and addition as R100 only when their object ID and mode are equal and that key has exactly one deletion and one addition.",
    "sets": {
      "checkpoint": "C = delta(requested_base, checkpoint)",
      "head": "H = delta(requested_base, current)",
      "resume_delta": "D = delta(checkpoint, current)",
      "carried": "H intersection C",
      "needs_review_now": "H minus C",
      "retired": "C minus H"
    }
  },
  "known_limitations": [
    "The five cases are deliberately selected diagnostics from one project and do not estimate population frequency or market size.",
    "A public Code-Review+2 event is evidence of Gerrit review state, not proof that every byte or cross-file effect was inspected.",
    "Exact identity carry-forward does not establish semantic safety, approval, or permission to merge.",
    "The benchmark measures classification correctness and observed focus share, not reviewer time, defect recall, or comprehension.",
    "The base-drift case validates conservative refusal; rebase-aware identity lineage remains a separate research track.",
    "Online provenance checks depend on Gerrit's public API remaining available and preserving the frozen semantic fields."
  ],

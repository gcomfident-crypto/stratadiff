{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gcomfident-crypto/stratadiff/main/benchmarks/reviewer-study-v1/pilot-plan.schema.json",
  "title": "StrataDiff Reviewer Pilot frozen assignment plan v1",
  "description": "A content-free assignment and adjudication schedule frozen before collection. Its seed may be disclosed after the plan is locked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "study_id",
    "protocol_version",
    "preregistration_sha256",
    "synthetic",
    "randomization",
    "task_catalog_sha256",
    "task_spec_sha256",
    "pilot_source_sha256",
    "stratadiff_build_sha256",
    "participants",
    "adjudicator_slots",
    "assignments"
  ],
  "properties": {
    "schema": { "const": "stratadiff-reviewer-pilot-plan-v1" },
    "study_id": { "$ref": "#/$defs/study_id" },
    "protocol_version": { "const": "1.0.0" },
    "preregistration_sha256": { "$ref": "#/$defs/sha256" },
    "synthetic": { "type": "boolean" },
    "randomization": { "$ref": "#/$defs/randomization" },
    "task_catalog_sha256": { "$ref": "#/$defs/sha256" },
    "task_spec_sha256": { "$ref": "#/$defs/sha256" },
    "pilot_source_sha256": { "$ref": "#/$defs/sha256" },
    "stratadiff_build_sha256": { "$ref": "#/$defs/sha256" },
    "participants": {
      "type": "array",
      "minItems": 4,
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/participant_id" }
    },
    "adjudicator_slots": {
      "type": "array",
      "minItems": 3,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/adjudicator_slot_id" }
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/assignment" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "synthetic": { "const": true } },
        "required": ["synthetic"]
      },
      "then": {
        "properties": { "study_id": { "pattern": "^study_synthetic_[0-9a-f]{16}$" } }
      },
      "else": {
        "properties": { "study_id": { "pattern": "^study_[0-9a-f]{16}$" } }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "study_id": {
      "type": "string",
      "pattern": "^study_(?:[0-9a-f]{16}|synthetic_[0-9a-f]{16})$"
    },
    "participant_id": {
      "type": "string",
      "pattern": "^p_[0-9a-f]{12}$"
    },
    "pair_id": {
      "type": "string",
      "pattern": "^pair_[0-9a-f]{12}$"
    },
    "task_family_id": {
      "type": "string",
      "pattern": "^task_[0-9a-f]{12}$"
    },
    "adjudicator_slot_id": {
      "type": "string",
      "pattern": "^adjslot_[0-9a-f]{12}$"
    },
    "carry_id": {
      "type": "string",
      "pattern": "^carry_[0-9a-f]{16}$"
    },
    "randomization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "seed_hex", "seed_commitment_sha256"],
      "properties": {
        "algorithm": { "const": "hmac-sha256-rejection-fisher-yates-v1" },
        "seed_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "seed_commitment_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_id",
        "participant_id",
        "task_family_id",
        "sequence",
        "assignment_order",
        "baseline_variant",
        "resume_variant",
        "arms",
        "adjudication"
      ],
      "properties": {
        "pair_id": { "$ref": "#/$defs/pair_id" },
        "participant_id": { "$ref": "#/$defs/participant_id" },
        "task_family_id": { "$ref": "#/$defs/task_family_id" },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 99 },
        "assignment_order": { "enum": ["baseline_then_resume", "resume_then_baseline"] },
        "baseline_variant": { "enum": ["a", "b"] },
        "resume_variant": { "enum": ["a", "b"] },
        "arms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "resume"],
          "properties": {
            "baseline": { "$ref": "#/$defs/arm" },
            "resume": { "$ref": "#/$defs/arm" }
          }
        },
        "adjudication": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/adjudication_unit" }
        }
      },
      "oneOf": [
        {
          "properties": {
            "baseline_variant": { "const": "a" },
            "resume_variant": { "const": "b" },
            "arms": {
              "properties": {
                "baseline": { "properties": { "variant": { "const": "a" } } },
                "resume": { "properties": { "variant": { "const": "b" } } }
              }
            }
          }
        },
        {
          "properties": {
            "baseline_variant": { "const": "b" },
            "resume_variant": { "const": "a" },
            "arms": {
              "properties": {
                "baseline": { "properties": { "variant": { "const": "b" } } },
                "resume": { "properties": { "variant": { "const": "a" } } }
              }
            }
          }
        }
      ]
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant", "bundle_sha256"],
      "properties": {
        "variant": { "enum": ["a", "b"] },
        "bundle_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "adjudication_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "counts_as_carry", "initial_slots", "resolver_slot"],
      "properties": {
        "unit_id": { "$ref": "#/$defs/carry_id" },
        "counts_as_carry": { "type": "boolean" },
        "initial_slots": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/adjudicator_slot_id" }
        },
        "resolver_slot": { "$ref": "#/$defs/adjudicator_slot_id" }
      }
    }
  }
}
